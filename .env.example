# ─────────────────────────────────────────────────────────────────────────────
#  AI Health Assistant — Environment Configuration Template
#  Copy to .env for local development or set these variables on your cloud host.
# ─────────────────────────────────────────────────────────────────────────────

# Environment: 'development' | 'production' | 'testing'
FLASK_ENV=development
DEBUG=True

# Flask Secret Key (Use a strong random hex key in production)
SECRET_KEY=change_this_to_a_secure_random_32_character_string

# Host and Port
HOST=0.0.0.0
PORT=5000

# Public Production Access URLs
# Replace with your actual domain when deployed (e.g., https://app.yourdomain.com)
PUBLIC_WEB_URL=http://127.0.0.1:5000
API_BASE_URL=http://127.0.0.1:5000

# Store URLs (Used on /download page and mobile deep links)
# Before store approval, you can leave placeholder URLs or your landing page.
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.health.aiassistant
IOS_STORE_URL=https://apps.apple.com/app/ai-health-assistant/id6739271845

# Database Configuration (SQLite local, PostgreSQL for cloud)
# SQLite example: sqlite:///health.db
# Cloud PostgreSQL example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///health.db

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of origins allowed to call the /api/* endpoints
ALLOWED_ORIGINS=*,http://localhost:5000,http://127.0.0.1:5000,capacitor://localhost,ionic://localhost

# Email Notifications (Optional SMTP setup)
EMAIL_DEV_MODE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
