# ─────────────────────────────────────────────────────────────────────────────
#  AI Health Assistant — Production Environment Template
#  Use these settings when deploying to Render, Railway, Fly.io, AWS, or Docker.
# ─────────────────────────────────────────────────────────────────────────────

FLASK_ENV=production
DEBUG=False

# Generated production secret key
SECRET_KEY=change_this_to_a_unique_64_character_hex_string_for_production

HOST=0.0.0.0
PORT=5000

# Public Production URLs (Configure with your live custom domain)
PUBLIC_WEB_URL=https://app.yourdomain.com
API_BASE_URL=https://app.yourdomain.com

# Store URLs (Update with real store IDs once approved)
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.health.aiassistant
IOS_STORE_URL=https://apps.apple.com/app/ai-health-assistant/id6739271845

# Cloud PostgreSQL Database URL
DATABASE_URL=postgresql://health_user:health_password@localhost:5432/health_db

# Security & CORS
ALLOWED_ORIGINS=*,https://app.yourdomain.com,capacitor://localhost,ionic://localhost
SESSION_COOKIE_SECURE=true

# Production SMTP Email Dispatch
EMAIL_DEV_MODE=false
MAIL_USERNAME=notifications@yourdomain.com
MAIL_PASSWORD=your_secure_smtp_app_password
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
